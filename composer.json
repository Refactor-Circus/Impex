{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "refactor-circus/impex",
    "description": "Workflow engine and data-flow ledger for Laravel, built for Vapor",
    "keywords": [
        "laravel",
        "refactor-circus",
        "impex",
        "workflow",
        "saga",
        "vapor"
    ],
    "homepage": "https://github.com/refactor-circus/impex",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "jayjfletcher@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "refactor-circus/atrium": "dev-main",
        "refactor-circus/keystone": "dev-main",
        "laravel/framework": "^13.35",
        "laravel/mcp": "^1.0.1"
    },
    "require-dev": {
        "refactor-circus/cortex": "dev-main",
        "refactor-circus/pennantplus": "dev-main",
        "larastan/larastan": "^3.13",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.1",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "phpstan/extension-installer": "^1.4.3"
    },
    "suggest": {
        "refactor-circus/cortex": "Let Cortex agents use the Impex tools and manage the MCP instructions and tool descriptions (dev-main).",
        "refactor-circus/pennantplus": "Switch Impex in Atrium on and off with the ImpexSupportFeature Pennant feature (dev-main)."
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\Impex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\Impex\\Database\\Factories\\": "database/factories/",
            "RefactorCircus\\Impex\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        },
        "files": [
            "tests/Fixtures/Flows.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:create-sqlite-db --ansi",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "RefactorCircus\\Impex\\ImpexServiceProvider"
            ],
            "aliases": {
                "Impex": "RefactorCircus\\Impex\\Facades\\Impex"
            }
        },
        "atrium": {
            "plugins": [
                "RefactorCircus\\Impex\\Atrium\\ImpexPlugin"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Atrium.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Cortex.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/PennantPlus.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Refactor-Circus/Keystone.git"
        }
    ]
}
