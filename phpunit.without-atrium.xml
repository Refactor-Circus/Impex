<?xml version="1.0" encoding="UTF-8"?>
<!--
    The WithoutAtrium suite: Impex boots and serves its JSON API and MCP with
    Atrium out of the autoloader. Run by `composer test:without-atrium`, which
    `composer test` calls after `@test:unit`; Pest is pointed at
    tests/WithoutAtrium so it loads that folder's Pest.php, never tests/Pest.php.

    The bootstrap removes the RefactorCircus\Atrium\ PSR-4 prefix from
    Composer's loader before any Atrium class loads. It cannot see Composer
    `files` or classmap leaks; the without-atrium CI job, which uninstalls
    Atrium, is the authoritative proof.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    backupGlobals="false"
    bootstrap="tests/WithoutAtrium/bootstrap.php"
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    executionOrder="random"
    failOnWarning="true"
    failOnRisky="true"
    failOnEmptyTestSuite="true"
    beStrictAboutOutputDuringTests="true"
    cacheDirectory=".phpunit.cache/without-atrium"
    backupStaticProperties="false"
>
    <testsuites>
        <testsuite name="WithoutAtrium">
            <directory>tests/WithoutAtrium</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
